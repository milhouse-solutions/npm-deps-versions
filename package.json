{
  "name": "deps-versions",
  "displayName": "Deps Versions",
  "description": "This extension adds CodeLens to package.json and pyproject.toml files showing available dependency upgrades. Supports npm/pip/uv with configurable CLI or HTTP methods.",
  "version": "1.0.6",
  "icon": "icon.png",
  "publisher": "milhouse-solutions",
  "repository": "https://github.com/milhouse-solutions/npm-deps-versions",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json",
    "workspaceContains:**/pyproject.toml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "title": "Enable CodeLens",
        "command": "deps-versions.enableCodeLens",
        "category": "Deps Versions"
      },
      {
        "title": "Disable Codelens",
        "command": "deps-versions.disableCodeLens",
        "category": "Deps Versions"
      },
      {
        "title": "Refresh Cache",
        "command": "deps-versions.refreshCache",
        "category": "Deps Versions"
      }
    ],
    "configuration": {
      "properties": {
        "deps-versions.npm.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for available npm dependency upgrades.",
          "order": 1
        },
        "deps-versions.npm.enableReleaseCandidateUpgrades": {
          "type": "boolean",
          "default": false,
          "description": "Search for release candidate versions (npm).",
          "order": 2
        },
        "deps-versions.npm.enableBetaUpgrades": {
          "type": "boolean",
          "default": false,
          "description": "Search for beta versions (npm).",
          "order": 3
        },
        "deps-versions.npm.enableAlphaUpgrades": {
          "type": "boolean",
          "default": false,
          "description": "Search for alpha versions (npm).",
          "order": 4
        },
        "deps-versions.npm.enableDevUpgrades": {
          "type": "boolean",
          "default": false,
          "description": "Search for developer versions (npm).",
          "order": 5
        },
        "deps-versions.npm.versionGetMethod": {
          "type": "string",
          "enum": ["cli", "http"],
          "description": "Method to fetch npm package versions: 'cli' uses npm CLI, 'http' uses HTTP requests to npm registry. Leave unset to be prompted on first use.",
          "order": 6
        },
        "deps-versions.npm.httpTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in milliseconds for HTTP requests to npm registry (HTTP mode only). Default is 30000ms (30 seconds) to match npm CLI timeout.",
          "order": 7
        },
        "deps-versions.python.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for available Python dependency upgrades.",
          "order": 8
        },
        "deps-versions.python.versionGetMethod": {
          "type": "string",
          "enum": ["cli", "http"],
          "description": "Method to fetch Python package versions: 'cli' uses pip/uv CLI, 'http' uses HTTP requests to PyPI. Leave unset to be prompted on first use.",
          "order": 9
        },
        "deps-versions.python.pipTool": {
          "type": "string",
          "enum": ["auto", "pip", "uv"],
          "default": "auto",
          "description": "Python package manager to use: 'auto' detects uv.lock file or uv command, 'pip' forces pip, 'uv' forces uv.",
          "order": 10
        },
        "deps-versions.python.httpTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in milliseconds for HTTP requests to PyPI (HTTP mode only). Default is 30000ms (30 seconds).",
          "order": 11
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "dependencies": {
    "semver": "^7.7.3",
    "@iarna/toml": "^2.2.5"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.27",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  }
}
